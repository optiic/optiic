{
  "name": "optiic",
  "version": "2.0.0",
  "description": "An advanced free OCR & image recognition API.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "scripts": {
    "start": "npm run prepare:watch",
    "build": "node -e \"require('prepare-package')()\"",
    "prepare": "node -e \"require('prepare-package')()\"",
    "test": "npm run build && mocha test/ --recursive --timeout=60000",
    "prepare:watch": "node -e \"require('prepare-package/watch')()\""
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=16"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/optiic/optiic"
  },
  "keywords": [
    "ocr",
    "ocr api",
    "image api",
    "image recognition",
    "image recognition api",
    "captcha",
    "captcha solver",
    "captcha api",
    "rest api"
  ],
  "author": "ITW Creative Works",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/optiic/optiic/issues"
  },
  "homepage": "https://optiic.dev",
  "runkitExampleFilename": "examples/process.js",
  "preparePackage": {
    "input": "src",
    "output": "dist",
    "type": "bundle",
    "build": {
      "formats": [
        "esm",
        "cjs",
        "iife"
      ],
      "iife": {
        "globalName": "Optiic",
        "fileName": "optiic.min.js"
      },
      "external": [
        "fs",
        "form-data",
        "wonderful-fetch"
      ]
    },
    "replace": {}
  },
  "dependencies": {
    "form-data": "^4.0.5",
    "itwcw-package-analytics": "^1.0.8",
    "wonderful-fetch": "^2.0.1"
  },
  "devDependencies": {
    "mocha": "^11.7.5",
    "prepare-package": "^2.0.5"
  }
}
